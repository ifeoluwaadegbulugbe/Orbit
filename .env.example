# Where email sign-ups and contact messages are stored. Set ONE of these.
# See docs/lead-capture-setup.md.

# Option A (easiest): a Google Apps Script web app URL that adds a row to a Google Sheet.
LEADS_WEBHOOK_URL=

# Option B: Supabase (a database table).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Weekly tips email, sent with Resend. See docs/lead-capture-setup.md.
# Sign-ups are saved without these, but no welcome or weekly email goes out.
RESEND_API_KEY=
# Must be on a domain verified in Resend, e.g. "Orbit <hello@getorbitcrm.com>"
RESEND_FROM=
# The Segment (list) in Resend that holds your subscribers.
RESEND_SEGMENT_ID=
# Any long random string. Vercel sends it with the weekly cron so only Vercel can trigger a send.
CRON_SECRET=
